# Bootstrap the home directory:
#   cd $HOME
#   mr -t bootstrap https://raw.githubusercontent.com/ajpippin/bootstrap/refs/heads/main/.mrconfig 
#
# raw.githubusercontent.com is a CDN, so it may have the wrong content cached.
#

[.]
checkout = git clone git@ssh.bitbucket.org:ajpippin/config-homedir.git .
